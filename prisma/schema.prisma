// ── UGC module ────────────────────────────────────────────────────────────────
// Native extension of the Affiliate System. Fully additive: new tables only, no
// change to any existing table's columns or data. UGC accounting (UgcEarning) and
// audit history (UgcVideoHistory) are append-only ledgers — every FK uses
// onDelete: Restrict so these records can NEVER disappear because an affiliate,
// product, or submission was removed. The application exposes no deletion flow for
// submissions, history, or earnings.
//
// DELETION MODEL (assumption behind the RESTRICT foreign keys):
//   Products and Affiliates that are referenced by UGC records are expected to be
//   ARCHIVED (soft-deleted / isActive=false), NOT physically deleted. A hard
//   delete of such a row is intentionally blocked by these RESTRICT FKs (Postgres
//   raises a foreign-key violation) so that UGC earnings and audit history are
//   never orphaned or lost. Preserving records is preferred over cascading them
//   away. Callers that need to "remove" a UGC-referenced product/affiliate must
//   archive it rather than delete it.
//
// MONETARY PRECISION:
//   All UGC money is Decimal(18,2) (NUMERIC). Every UGC calculation — including
//   the balance term added to the affiliate balance — stays in Prisma.Decimal
//   from the database aggregate through to the final serialization boundary. No
//   Decimal -> Number -> Decimal round-trips.

enum UgcStatus {
  PENDING
  APPROVED
  RUNNING
  PAUSED
  REJECTED
}

// One affiliate + one product = exactly one submission (enforced by @@unique).
// A rejected submission is REPLACED in place (video swapped, status → PENDING),
// never re-created — full history is kept in UgcVideoHistory.
model UgcVideoSubmission {
  id                   String    @id @default(uuid())
  affiliateId          String
  productId            String
  videoUrl             String
  storageKey           String?
  description          String?
  status               UgcStatus @default(PENDING)
  advertisingConsent   Boolean   @default(false)
  advertisingConsentAt DateTime?
  submittedAt          DateTime  @default(now())
  approvedAt           DateTime?
  rejectedAt           DateTime?
  pausedAt             DateTime?
  resumedAt            DateTime?
  rejectionReason      String?
  internalAdminNotes   String? // ADMIN-ONLY — never serialized to affiliate responses
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  affiliate Affiliate         @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  product   Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  histories UgcVideoHistory[]
  earnings  UgcEarning[]
  dailyTargets UgcDailyTarget[]

  @@unique([affiliateId, productId])
  @@index([affiliateId])
  @@index([productId])
  @@index([status])
  @@index([createdAt])
  @@map("ugc_video_submissions")
}

// Append-only audit trail of every video swap and status transition.
// No cascade delete: history survives even if a submission were ever removed.
model UgcVideoHistory {
  id          String     @id @default(uuid())
  ugcVideoId  String
  oldVideoUrl String?
  newVideoUrl String?
  oldStatus   UgcStatus?
  newStatus   UgcStatus?
  action      String // SUBMIT | REPLACE | APPROVE | REJECT | PAUSE | RESUME
  actorId     String?
  actorType   String // AFFILIATE | ADMIN | SYSTEM
  reason      String?
  createdAt   DateTime   @default(now())

  submission UgcVideoSubmission @relation(fields: [ugcVideoId], references: [id], onDelete: Restrict)

  @@index([ugcVideoId])
  @@index([createdAt])
  @@map("ugc_video_history")
}

// Immutable UGC earnings ledger. Monetary fields use Decimal(18,2) (NUMERIC) —
// all UGC money math is Decimal-safe server-side. commissionPerSale is snapshotted
// at generation time so a later settings change never alters historical earnings.
// idempotencyKey = "ugcVideoId:generationPeriod" (unique) is the final duplicate
// guard behind the engine's advisory lock.
model UgcEarning {
  id                String   @id @default(uuid())
  affiliateId       String
  ugcVideoId        String
  productId         String
  generatedSales    Int
  commissionPerSale Decimal  @db.Decimal(18, 2)
  amount            Decimal  @db.Decimal(18, 2)
  generationDate    DateTime // day bucket — aggregate-ready
  generationPeriod  String // uniquely identifies the configured earning interval
  idempotencyKey    String   @unique
  status            String   @default("available")
  createdAt         DateTime @default(now())

  submission UgcVideoSubmission @relation(fields: [ugcVideoId], references: [id], onDelete: Restrict)

  @@index([affiliateId])
  @@index([ugcVideoId])
  @@index([generationPeriod])
  @@index([generationDate])
  @@index([createdAt])
  @@map("ugc_earnings")
}

/// One simulated-sales DAILY TARGET per RUNNING video per business day.
/// The engine picks `dailyTarget` once (random in [minGeneratedSales, maxGeneratedSales])
/// and tracks `generatedToday` as individual simulated sales are emitted (one UgcEarning
/// each). `generationDate` is the business-day bucket (TZ-local midnight instant, same TZ
/// as the earnings ledger). No pre-scheduled sale rows: pacing is derived from
/// `generatedToday` + the ledger, so it is restart-safe. Additive — never touches UgcEarning.
model UgcDailyTarget {
  id             String   @id @default(uuid())
  ugcVideoId     String
  affiliateId    String
  generationDate DateTime // business-day bucket (TZ-local midnight instant)
  businessDate   String   // "YYYY-MM-DD" in the configured timezone (idempotency + audit)
  timezone       String   // timezone in effect when the target was created
  dailyTarget    Int
  generatedToday Int      @default(0)
  completed      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  submission UgcVideoSubmission @relation(fields: [ugcVideoId], references: [id], onDelete: Restrict)

  @@unique([ugcVideoId, generationDate])
  @@index([affiliateId])
  @@index([generationDate])
  @@index([completed])
  @@map("ugc_daily_targets")
}

/// Append-only audit trail of UGC settings changes.
/// `changes` is a JSON array of { key, from, to }. `earningsAffecting` flags a
/// change to a key that influences money generation (commission, generation
/// bounds, engine flag, …) so those edits can be reviewed independently.
/// Written best-effort: a failure here must NEVER block saving settings.
model UgcSettingsHistory {
  id                String   @id @default(uuid())
  actorId           String?
  actorType         String   @default("ADMIN")
  changes           Json
  earningsAffecting Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([earningsAffecting])
  @@map("ugc_settings_history")
}

/// Admin-facing notifications (currently: a new UGC submission awaiting review).
/// Deliberately generic so other admin events can reuse it. No FK to the UGC
/// submission: notifications must survive independently of the entity lifecycle.
model AdminNotification {
  id        String   @id @default(uuid())
  type      String
  message   String
  entityId  String?
  read      Boolean  @default(false)
  /// Deterministic dedup key: `ugc:{submissionId}:{historyId}:{eventType}:admin`.
  eventKey  String?  @unique
  createdAt DateTime @default(now())

  @@index([read])
  @@index([type])
  @@index([createdAt])
  @@map("admin_notifications")
}

// ══ Rewards & Gifts (affiliate points program) ═══════════════════════════════
// Entirely ADDITIVE. Points are a separate currency from commissions: nothing
// here is registered as a balance provider, so the MAD wallet, payouts and
// boosters are unaffected. The append-only ledger is the source of truth;
// RewardPointsAccount.balance is a lockable running total updated in the same
// transaction as every ledger row (verifyAccountBalance checks they agree).
// Points are always integers. Status/type columns are TEXT with CHECK
// constraints in the migration (20261019_affiliate_rewards).

/// Physical gift catalog. Archived (never hard-deleted) once referenced.
model RewardGift {
  id                 String             @id @default(uuid())
  name               String
  description        String             @default("")
  images             Json               @default("[]")
  pointsCost         Int
  stock              Int                @default(0) // CHECK stock >= 0
  lowStockThreshold  Int?
  maxPerAffiliate    Int?
  minDeliveredOrders Int?
  isActive           Boolean            @default(false)
  archivedAt         DateTime?
  sortOrder          Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  redemptions        RewardRedemption[]

  @@index([isActive])
  @@index([sortOrder])
  @@map("reward_gifts")
}

/// One row per affiliate: running total + the row every points operation locks
/// first (UPDATE → row lock), which serialises all point changes per affiliate.
/// balance may be negative ONLY through an order reversal (D3 "points debt").
model RewardPointsAccount {
  affiliateId String    @id
  balance     Int       @default(0)
  version     Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Restrict)

  @@map("reward_points_accounts")
}

/// Append-only points ledger (UPDATE/DELETE blocked by a DB trigger).
/// type: SIGNUP_BONUS | ORDER_DELIVERED | ORDER_REVERSAL | REDEMPTION_DEBIT |
///       REDEMPTION_REFUND | ADMIN_ADJUSTMENT
model RewardPointsLedger {
  id             String    @id @default(uuid())
  affiliateId    String
  delta          Int // CHECK delta <> 0
  type           String
  sourceType     String // affiliate | affiliate_order | redemption | admin
  sourceId       String?
  idempotencyKey String    @unique
  reason         String?
  actorType      String    @default("SYSTEM") // SYSTEM | ADMIN | AFFILIATE
  actorId        String?
  balanceAfter   Int
  metadata       Json?
  createdAt      DateTime  @default(now())
  affiliate      Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Restrict)

  @@index([affiliateId, createdAt])
  @@index([type])
  @@index([sourceType, sourceId])
  @@map("reward_points_ledger")
}

/// Per-order award state machine — the idempotency anchor for order points.
/// state: AWARDED | REVERSED | EXCLUDED (EXCLUDED = delivered before launch,
/// recorded by the launch baseline; never awarded). `points` is the snapshot
/// taken at the FIRST award and reused on re-award (D9). orderId (the linked
/// store Order) is unique so one real order can never pay out twice, but has
/// no FK: store orders may be hard-deleted by an admin.
model RewardOrderAward {
  id               String         @id @default(uuid())
  affiliateOrderId String         @unique
  orderId          String?        @unique
  affiliateId      String
  points           Int            @default(0)
  state            String
  exclusionReason  String?
  version          Int            @default(1)
  availableAt      DateTime? // end of the hold period (D4)
  awardedAt        DateTime?
  reversedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  affiliateOrder   AffiliateOrder @relation(fields: [affiliateOrderId], references: [id], onDelete: Restrict)
  affiliate        Affiliate      @relation(fields: [affiliateId], references: [id], onDelete: Restrict)

  @@index([affiliateId, state])
  @@map("reward_order_awards")
}

/// A gift request. status: PENDING_REVIEW | APPROVED | PREPARING | SHIPPED |
/// IN_TRANSIT | DELIVERED | REJECTED | CANCELLED | RETURNED. Points are debited
/// and stock reserved at creation; refund/restock are stamped so they happen once.
model RewardRedemption {
  id               String                    @id @default(uuid())
  reference        String                    @unique
  affiliateId      String
  giftId           String
  giftSnapshot     Json
  pointsCost       Int
  status           String                    @default("PENDING_REVIEW")
  fullName         String
  phone            String
  city             String
  address          String
  deliveryNotes    String?
  carrierId        String?
  carrierName      String?
  trackingNumber   String?
  trackingUrl      String?
  internalNotes    String? // admin-only — never returned to affiliates
  rejectionReason  String?
  cancelReason     String?
  clientRequestId  String
  pointsRefundedAt DateTime?
  restockedAt      DateTime?
  approvedAt       DateTime?
  preparingAt      DateTime?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  closedAt         DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  affiliate        Affiliate                 @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  gift             RewardGift                @relation(fields: [giftId], references: [id], onDelete: Restrict)
  history          RewardRedemptionHistory[]

  @@unique([affiliateId, clientRequestId])
  @@index([affiliateId, createdAt])
  @@index([status])
  @@index([giftId])
  @@map("reward_redemptions")
}

/// Every redemption status change (append-only).
model RewardRedemptionHistory {
  id           String           @id @default(uuid())
  redemptionId String
  fromStatus   String?
  toStatus     String
  actorType    String // SYSTEM | ADMIN | AFFILIATE
  actorId      String?
  note         String?
  createdAt    DateTime         @default(now())
  redemption   RewardRedemption @relation(fields: [redemptionId], references: [id], onDelete: Restrict)

  @@index([redemptionId, createdAt])
  @@map("reward_redemption_history")
}

/// Settings changes, gift edits, stock changes and other admin actions.
model RewardAuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String?
  actorType  String   @default("ADMIN")
  actorId    String?
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("reward_audit_log")
}

// ── "Create Your Own Brand" — paid TRAINING & SIMULATION experience ────────────
// Fully additive and isolated. A participant buys ACCESS to a brand simulator;
// the simulated activity lives only in brand_sim_hours. Nothing here is a real
// order, sale or earning: no table below is read by the order pipeline,
// commissions, Rewards, the Fake Orders Engine or any wallet balance provider.

/// One purchase of access to the simulator (fictional brand name + package).
/// PENDING_PAYMENT → ACTIVE (admin, after verifying the payment) | REJECTED (admin)
/// | CANCELLED (participant, while still pending). Package, price, branding and
/// accepted refund terms are snapshotted at request time.
/// NOTE: a PARTIAL unique index (one PENDING_PAYMENT/ACTIVE access per affiliate)
/// is created in the migration via raw SQL (Prisma's DSL can't express it).
model BrandAccess {
  id                 String         @id @default(uuid())
  affiliateId        String
  brandName          String
  packageId          String
  packageSnapshot    Json
  brandingOptionId   String?
  brandingSnapshot   Json?
  amount             Decimal        @db.Decimal(12, 2)
  termsVersion       Int
  termsSnapshot      Json
  /// SHA-256 (lowercase hex, UTF-8 bytes) of the accepted terms text. New requests only;
  /// NULL on legacy rows (never backfilled). Frozen after insert (DB trigger).
  termsTextSha256    String?
  /// Selected catalogue products: [{ id, title, image }] snapshotted from the store (3–4, DB check)
  selectedProducts   Json           @default("[]")
  clientRequestId    String
  status             String         @default("PENDING_PAYMENT")
  paymentReference   String?
  activatedAt        DateTime?
  activatedBy        String?
  simulationStartsAt DateTime?
  closedAt           DateTime?
  closedBy           String?
  closeReason        String?
  /// Single-use admin authorization consumed by this request (required after a CLOSED access; DB trigger)
  authorizationId    String?        @unique
  /// Simulation generation progress: every hour before this instant has been processed (idempotent batches)
  generatedThrough   DateTime?
  lastReopenedAt     DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  affiliate          Affiliate      @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  authorization      BrandRequestAuthorization? @relation(fields: [authorizationId], references: [id], onDelete: Restrict)
  simHours           BrandSimHour[]
  periods            BrandAccessPeriod[]
  paymentProof       BrandPaymentProof?
  consents           BrandAccessConsent[]

  @@unique([affiliateId, clientRequestId])
  @@index([affiliateId])
  @@index([status])
  @@index([createdAt])
  @@map("brand_accesses")
}

/// SIMULATED training data: one row per completed hour of one access (outcome
/// counts of fictional orders). Written once per hour (ON CONFLICT DO NOTHING) —
/// the generator is deterministic, so a retry can never duplicate or change it.
model BrandSimHour {
  accessId   String
  hourStart  DateTime
  created    Int
  delivered  Int
  refused    Int
  returned   Int
  noResponse Int
  cancelled  Int
  createdAt  DateTime    @default(now())
  access     BrandAccess @relation(fields: [accessId], references: [id], onDelete: Cascade)

  @@id([accessId, hourStart])
  @@map("brand_sim_hours")
}

/// Append-only audit trail: config and terms changes, access requests,
/// activations, rejections and cancellations.
model BrandAuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String?
  actorType  String   @default("ADMIN")
  actorId    String?
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("brand_audit_log")
}

/// Append-only versions of the simulation settings that influence generated
/// history (enabled flag, daily volume, outcome split, display delays), each with
/// the instant it took effect. `proven = false` marks a period whose settings
/// cannot be established from the audit trail: no history is generated there.
model BrandSimSettingsVersion {
  id            String   @id @default(uuid())
  effectiveFrom DateTime
  enabled       Boolean
  proven        Boolean
  settings      Json
  source        String
  auditId       String?  @unique
  createdAt     DateTime @default(now())

  @@index([effectiveFrom])
  @@map("brand_sim_settings_versions")
}

/// One activation / reopening interval of an access (end = closure). History is
/// generated only inside these intervals. NOTE: one open period per access is a
/// PARTIAL unique index created in the migration.
model BrandAccessPeriod {
  id           String      @id @default(uuid())
  accessId     String
  startedAt    DateTime
  endedAt      DateTime?
  startReason  String
  startAuditId String?
  endAuditId   String?
  createdAt    DateTime    @default(now())
  access       BrandAccess @relation(fields: [accessId], references: [id], onDelete: Restrict)

  @@index([accessId, startedAt])
  @@map("brand_access_periods")
}

/// Payment proof of ONE brand request — never an AffiliateSecurityDeposit and
/// never a wallet credit. fileKey is a PRIVATE storage key (never sent to clients).
model BrandPaymentProof {
  id                          String      @id @default(uuid())
  accessId                    String      @unique
  fileKey                     String
  fingerprint                 String      @unique
  paymentMethod               String
  transferReference           String?
  transferReferenceNormalized String?
  status                      String      @default("SUBMITTED")
  reviewedBy                  String?
  reviewedAt                  DateTime?
  rejectionReason             String?
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt
  access                      BrandAccess @relation(fields: [accessId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([transferReferenceNormalized])
  @@map("brand_payment_proofs")
}

/// Single-use admin authorization for a new request after a CLOSED access.
/// Append-only: only "consume" or "revoke" (once) — DB trigger. NOTE: one unused
/// authorization per affiliate is a PARTIAL unique index created in the migration.
model BrandRequestAuthorization {
  id                 String       @id @default(uuid())
  affiliateId        String
  grantedBy          String
  reason             String
  grantAuditId       String?
  createdAt          DateTime     @default(now())
  revokedAt          DateTime?
  revokedBy          String?
  revokeReason       String?
  revokeAuditId      String?
  consumedAt         DateTime?
  consumedByAccessId String?      @unique
  affiliate          Affiliate    @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  access             BrandAccess?

  @@index([affiliateId])
  @@map("brand_request_authorizations")
}

/// One immutable row per PUBLISHED refund-terms version: exact text and the SHA-256
/// of its UTF-8 bytes. Append-only: no UPDATE / DELETE / TRUNCATE (DB triggers).
/// Written by the publish action in the same transaction as the settings and audit
/// row; earlier versions backfilled by migration 20261030 from reliable sources only.
model BrandTermsVersion {
  version        Int      @id
  text           String
  textSha256     String
  publishedAt    DateTime
  publishedBy    String?
  publishAuditId String?  @unique
  source         String // PUBLISH | BACKFILL_AUDIT | BACKFILL_SETTINGS
  createdAt      DateTime @default(now())

  @@map("brand_terms_versions")
}

/// FRESH consent given later by the participant, kept separately from the request's
/// original consent snapshot (which is never changed). Append-only (DB triggers);
/// acceptedAt is written by the database. PENDING_RENEWAL never authorizes payment;
/// REOPEN_RENEWAL to the latest version allows reopening a CLOSED request.
model BrandAccessConsent {
  id              String      @id @default(uuid())
  accessId        String
  affiliateId     String
  context         String // PENDING_RENEWAL | REOPEN_RENEWAL
  termsVersion    Int
  termsTextSha256 String
  acceptedAt      DateTime    @default(now())
  auditId         String?     @unique
  createdAt       DateTime    @default(now())
  access          BrandAccess @relation(fields: [accessId], references: [id], onDelete: Restrict)

  @@index([accessId])
  @@map("brand_access_consents")
}

/// Payment Proofs — an admin-managed DISPLAY / ANNOUNCEMENT feed shown to all
/// active affiliates in the dashboard slider. Completely independent: no relation
/// to affiliates, users, payouts, balances, commissions, rewards or any financial
/// record. displayName / displayAmountCents are presentation data typed by the admin.
/// Lifecycle: SCHEDULED → PUBLISHED | CANCELLED | FAILED; FAILED → SCHEDULED | CANCELLED.
/// PUBLISHED and CANCELLED are final (DB trigger). Rows are never deleted (DB trigger).
/// Visible to affiliates only while publishedAt <= now < publishedAt + 72 h.
/// Partial unique index (migration): one non-cancelled proof per receipt fingerprint.
model PaymentProof {
  id                      String              @id @default(uuid())
  displayName             String
  displayAmountCents      Int
  fileKey                 String              @unique
  fingerprint             String
  publicToken             String              @unique
  status                  String              @default("SCHEDULED")
  scheduledAt             DateTime
  publishedAt             DateTime?
  cancelledAt             DateTime?
  failedAt                DateTime?
  failureReason           String?
  publishAttempts         Int                 @default(0)
  /// Display duration captured at the ACTUAL publication (global setting at that moment) and the
  /// resulting end of display (= publishedAt + visibleHours). NULL before publication and for proofs
  /// published before 20261114 (those keep the original 72 h rule). Never changes once published.
  visibleHours            Int?
  visibleUntil            DateTime?
  batchId                 String?
  clientRef               String              @unique
  privacyConfirmedAt      DateTime
  privacyConfirmedBy      String
  authenticityConfirmedAt DateTime
  authenticityConfirmedBy String
  createdBy               String?
  updatedBy               String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  events                  PaymentProofEvent[]

  @@index([status, scheduledAt])
  @@index([status, publishedAt])
  @@index([status, visibleUntil])
  @@index([batchId])
  @@map("payment_proofs")
}

/// Append-only audit history of one payment proof (DB trigger: no UPDATE / DELETE). A REMOVE event
/// ("Supprimer") takes the proof off the slider for good; at most one per proof (partial unique index in SQL).
model PaymentProofEvent {
  id      String       @id @default(uuid())
  /// Insertion order (events of one transaction share the same `at`).
  seq     BigInt       @unique @default(autoincrement())
  proofId String
  action  String
  actor   String
  at      DateTime     @default(now())
  details Json?
  proof   PaymentProof @relation(fields: [proofId], references: [id], onDelete: Restrict)

  @@index([proofId, at])
  @@map("payment_proof_events")
}

model DemoCompMember {
  // Demo Competition (Top Members / Top Brands): SIMULATION ONLY. A demo member is a fictitious
  // leaderboard profile — never a real affiliate, order, sale, commission, balance or payout. All
  // amounts are simulated reporting values in centimes. Current settings live here; every change is
  // also appended to demo_comp_member_versions, which the engine reads (history is never recomputed).
  id                       String                  @id @default(uuid())
  name                     String
  photoUrl                 String?
  active                   Boolean                 @default(true)
  minDailyOrders           Int                     @default(5)
  maxDailyOrders           Int                     @default(30)
  priceCents               Int                     @default(30000)
  allocationBps            Int                     @default(3000)
  networkAffiliates        Int                     @default(0)
  networkMinDailyOrders    Int                     @default(0)
  networkMaxDailyOrders    Int                     @default(0)
  networkPriceCents        Int?
  networkAllocationBps     Int?
  personalGeneratedThrough DateTime?
  networkGeneratedThrough  DateTime?
  // Archived (instead of deleted): no longer generates and leaves the public rankings; history kept.
  archivedAt               DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  versions                 DemoCompMemberVersion[]
  brands                   DemoCompBrand[]
  plans                    DemoCompDailyPlan[]
  events                   DemoCompEvent[]

  @@index([active])
  @@map("demo_comp_members")
}

model DemoCompMemberVersion {
  // Append-only settings history of one demo member (effectiveFrom ascending). A day's plan uses the
  // version in force at the day's start; an event uses the version in force at its scheduled time.
  id                    String         @id @default(uuid())
  memberId              String
  effectiveFrom         DateTime
  active                Boolean
  minDailyOrders        Int
  maxDailyOrders        Int
  priceCents            Int
  allocationBps         Int
  networkAffiliates     Int
  networkMinDailyOrders Int
  networkMaxDailyOrders Int
  networkPriceCents     Int?
  networkAllocationBps  Int?
  createdBy             String?
  createdAt             DateTime       @default(now())
  member                DemoCompMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, effectiveFrom])
  @@map("demo_comp_member_versions")
}

model DemoCompBrand {
  // A demo brand (simulation only), owned by one demo member (a member may own several brands).
  id               String                 @id @default(uuid())
  name             String
  imageUrl         String?
  ownerId          String
  active           Boolean                @default(true)
  minDailyOrders   Int                    @default(5)
  maxDailyOrders   Int                    @default(30)
  priceCents       Int                    @default(30000)
  allocationBps    Int                    @default(7000)
  generatedThrough DateTime?
  // Archived (instead of deleted): no longer generates and leaves the public rankings; history kept.
  archivedAt       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  owner            DemoCompMember         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  versions         DemoCompBrandVersion[]
  plans            DemoCompDailyPlan[]
  events           DemoCompEvent[]

  @@index([ownerId])
  @@index([active])
  @@map("demo_comp_brands")
}

model DemoCompBrandVersion {
  // Append-only settings history of one demo brand (same rules as the member versions).
  id             String        @id @default(uuid())
  brandId        String
  effectiveFrom  DateTime
  active         Boolean
  minDailyOrders Int
  maxDailyOrders Int
  priceCents     Int
  allocationBps  Int
  createdBy      String?
  createdAt      DateTime      @default(now())
  brand          DemoCompBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, effectiveFrom])
  @@map("demo_comp_brand_versions")
}

model DemoCompDailyPlan {
  // One immutable plan per stream (PERSONAL / NETWORK / BRAND) per profile per Africa/Casablanca
  // day: the day's target number of demo orders, drawn deterministically within the min / max of
  // the version in force at the day's start (snapshotted here).
  id           String          @id @default(uuid())
  stream       String
  profileKey   String
  memberId     String?
  brandId      String?
  dayKey       String
  dayStart     DateTime
  dayEnd       DateTime
  targetOrders Int
  minOrders    Int
  maxOrders    Int
  versionId    String
  createdAt    DateTime        @default(now())
  member       DemoCompMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  brand        DemoCompBrand?  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  events       DemoCompEvent[]

  @@unique([stream, profileKey, dayKey])
  @@index([memberId])
  @@index([brandId])
  @@map("demo_comp_daily_plans")
}

model DemoCompEvent {
  // Immutable demo sale event (append-only). quantity = 1..3 simulated orders; the price, allocation
  // and earnings are snapshots of the version in force at scheduledAt, so a later settings change
  // never recalculates history. earningsCents = round(quantity × priceCents × allocationBps / 10000),
  // enforced by a CHECK. idempotencyKey = <stream>:<profileId>:<dayKey>:<seq>.
  id             String            @id @default(uuid())
  eventType      String
  memberId       String?
  brandId        String?
  planId         String
  seq            Int
  quantity       Int
  priceCents     Int
  allocationBps  Int
  earningsCents  Int
  versionId      String
  scheduledAt    DateTime
  createdAt      DateTime          @default(now())
  idempotencyKey String            @unique
  member         DemoCompMember?   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  brand          DemoCompBrand?    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  plan           DemoCompDailyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([memberId, eventType, scheduledAt])
  @@index([brandId, scheduledAt])
  @@index([scheduledAt])
  @@map("demo_comp_events")
}

model DemoCompEngine {
  // Single row (id "engine"): the demo engine switch, its last run, and the default price /
  // allocations proposed for new demo profiles (member and brand streams validated separately).
  // resumedAt / pausedAt: when the engine was last switched ON / OFF — nothing is generated for the time it was
  // OFF (a profile created while OFF gets its history only up to pausedAt; never switched ON yet → up to now).
  id                String    @id @default("engine")
  enabled           Boolean   @default(false)
  defaultPriceCents Int       @default(30000)
  defaultMemberBps  Int       @default(3000)
  defaultBrandBps   Int       @default(7000)
  initializedAt     DateTime?
  resumedAt         DateTime?
  pausedAt          DateTime?
  lastRunAt         DateTime?
  lastRunEvents     Int       @default(0)
  lastError         String?
  updatedAt         DateTime  @updatedAt

  @@map("demo_comp_engine")
}

// ── Affiliate Recruiter System ─────────────────────────────────────────────────
// Recruiters are a SEPARATE principal (own table, own login, JWT type "recruiter"),
// never a User role and never an Affiliate. A recruiter CREATES affiliate accounts
// (inactive / pending verification) and links each one to the affiliate who brought
// them (affiliates.parentId). Existing affiliates can never be assigned to a recruiter.
// Nothing here changes an existing affiliates column, balance, commission, reward or payout.

/// A recruiter account, created and disabled by an admin.
model Recruiter {
  id                  String                     @id @default(uuid())
  username            String                     @unique
  name                String
  phone               String?                    @unique
  passwordHash        String
  isActive            Boolean                    @default(true)
  canCreateAffiliates Boolean                    @default(true)
  canViewOrders       Boolean                    @default(true)
  disabledAt          DateTime?
  disabledBy          String?
  disabledReason      String?
  lastLoginAt         DateTime?
  createdBy           String
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  // Bank details for withdrawals (Phase 5) — same fields and rules as the affiliate ones.
  bankName            String?
  rib                 String?
  accountName         String?
  // Session version (Phase 6 part 2): bumped on disable / enable / password change / reset.
  tokenVersion        Int                        @default(0)
  affiliateLinks      RecruiterAffiliateLink[]
  rewards             RecruiterRewardLedger[]
  auditLogs           RecruiterAuditLog[]
  payouts             AffiliatePayout[]
  // Identity verification (Phase 6 part 3c) — separate from the affiliate IdentityVerification.
  identityVerification RecruiterIdentityVerification?

  @@index([isActive])
  @@map("recruiters")
}

/// A recruiter's identity verification (CIN front + back) — Phase 6 part 3c. SEPARATE from the
/// affiliate IdentityVerification. One row per recruiter (no row = NOT_SUBMITTED). Transitions and
/// the status/review columns are enforced by the DB (migration 20261111): PENDING → APPROVED |
/// REJECTED, APPROVED → REJECTED (revocation), REJECTED → PENDING only through a new upload
/// (submission + 1). The row is never deleted; history lives in recruiter_audit_log.
model RecruiterIdentityVerification {
  id              String    @id @default(uuid())
  recruiterId     String    @unique
  status          String // PENDING | APPROVED | REJECTED
  submission      Int // 1, 2, … — an admin decision names it, so a stale decision is refused
  cinFrontFile    String // private storage key — never returned to a recruiter, never audited
  cinBackFile     String // private storage key
  rejectionReason String?
  submittedAt     DateTime
  reviewedBy      String?
  reviewedAt      DateTime?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  recruiter       Recruiter @relation(fields: [recruiterId], references: [id], onDelete: Restrict)

  @@index([status, submittedAt])
  @@map("recruiter_identity_verifications")
}

/// The recruiter who CREATED an affiliate (one per affiliate). Only insertable in the
/// same transaction that creates that (inactive) affiliate — so an existing affiliate
/// can never be assigned — and immutable afterwards (DB triggers).
model RecruiterAffiliateLink {
  affiliateId String    @id
  recruiterId String
  createdBy   String
  createdAt   DateTime  @default(now())
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  recruiter   Recruiter @relation(fields: [recruiterId], references: [id], onDelete: Restrict)

  @@index([recruiterId, createdAt])
  @@map("recruiter_affiliate_links")
}

/// Append-only reward ledger of recruiters, in MAD only (integer cents) — completely
/// separate from affiliate balances, commissions, reward points and payouts.
/// One RECRUIT_REWARD (and at most one REVERSAL) per affiliate; idempotencyKey unique.
model RecruiterRewardLedger {
  id              String     @id @default(uuid())
  seq             BigInt     @unique @default(autoincrement())
  recruiterId     String
  affiliateId     String?
  type            String // RECRUIT_REWARD | REVERSAL | ADMIN_ADJUSTMENT
  amountCents     Int // MAD cents (1500 = 15.00 MAD)
  idempotencyKey  String     @unique
  reason          String?
  actorType       String // SYSTEM | ADMIN
  actorId         String?
  settingsVersion Int?
  // Reward / reversal cycle of the affiliate (Phase 6 part 3a): cycle n = one RECRUIT_REWARD and
  // at most one REVERSAL (keys recruit:<id>:v<n> / reverse:<id>:v<n>; rows before the cycles
  // read 1 with their legacy keys). Unique per (affiliate, cycle, type) and alternating — DB.
  cycle           Int
  createdAt       DateTime   @default(now())
  recruiter       Recruiter  @relation(fields: [recruiterId], references: [id], onDelete: Restrict)
  affiliate       Affiliate? @relation(fields: [affiliateId], references: [id], onDelete: Restrict)

  @@index([recruiterId, createdAt])
  @@index([affiliateId])
  @@map("recruiter_reward_ledger")
}

/// Append-only audit log of the recruiter system (recruiter, admin and system actions).
model RecruiterAuditLog {
  id          String     @id @default(uuid())
  seq         BigInt     @unique @default(autoincrement())
  recruiterId String?
  actorType   String // RECRUITER | ADMIN | SYSTEM
  actorId     String
  action      String
  entityType  String?
  entityId    String?
  details     Json?
  createdAt   DateTime   @default(now())
  recruiter   Recruiter? @relation(fields: [recruiterId], references: [id], onDelete: Restrict)

  @@index([recruiterId, createdAt])
  @@index([entityType, entityId])
  @@map("recruiter_audit_log")
}

/// Append-only, consecutive versions of the recruiter settings set by the admin: the
/// reward amount (MAD cents) and the number of real delivered orders required (default
/// 10). A reward is due when the affiliate created by the recruiter has that many real
/// delivered orders AND an APPROVED CIN (existing IdentityVerification). Current =
/// highest version; a reward row records the version it was computed with.
model RecruiterSettingsVersion {
  version           Int      @id
  enabled           Boolean
  rewardAmountCents Int
  minDeliveredSales Int
  createdBy         String
  createdAt         DateTime @default(now())
  // Reward B — group reward (Phase 7, migration 20261112): the amount (MAD cents) earned each time
  // groupSize distinct affiliates of the recruiter each have groupMinDeliveredSales real delivered
  // orders and an APPROVED CIN. Rows written before the migration read these defaults (OFF).
  // Ledger rows GROUP_REWARD / GROUP_REVERSAL (no affiliate, cycles per recruiter) — DB CHECKs.
  groupEnabled           Boolean @default(false)
  groupRewardAmountCents Int     @default(0)
  groupSize              Int     @default(10)
  groupMinDeliveredSales Int     @default(10)

  @@map("recruiter_settings_versions")
}

/// One-time activation code of an affiliate created by a recruiter (Phase 6, part 1): the
/// affiliate chooses their OWN password with it. Only a SHA-256 hash of the secret part is
/// stored; the plaintext is shown once to the recruiter. Single use, 24 h, 5 failed
/// attempts, at most one active code per affiliate (partial unique index); a new code
/// invalidates the previous one. Redeeming it never activates the account (admin approval
/// stays the only activation). Rows are never deleted; their history is kept (DB triggers).
model AffiliateActivationCode {
  id                  String    @id @default(uuid())
  affiliateId         String
  selector            String    @unique
  verifierHash        String
  passwordFingerprint String
  createdByType       String // RECRUITER | ADMIN
  createdById         String
  createdAt           DateTime  @default(now())
  expiresAt           DateTime
  failedAttempts      Int       @default(0)
  usedAt              DateTime?
  invalidatedAt       DateTime?
  invalidatedReason   String? // REGENERATED | TOO_MANY_ATTEMPTS | CREDENTIALS_CHANGED | ADMIN_RECOVERY
  affiliate           Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  recoveries          AffiliateActivationRecovery[]

  @@index([affiliateId, createdAt])
  @@map("affiliate_activation_codes")
}

/// Admin activation RECOVERY request (Phase 6, part 1): an affiliate reports that their
/// activation code was used before them. An admin reviews it; approval replaces the password
/// with an unusable one, invalidates the active code and issues a fresh ADMIN code shown once
/// to that admin (never to the recruiter). Only for INACTIVE affiliates of the code flow; the
/// admin approval (isActive) stays the only activation. One PENDING request per affiliate;
/// rows are never deleted and move PENDING → APPROVED | REJECTED once (DB triggers).
model AffiliateActivationRecovery {
  id               String                   @id @default(uuid())
  affiliateId      String
  status           String                   @default("PENDING") // PENDING | APPROVED | REJECTED
  message          String
  contactPhone     String?
  requestIp        String?
  requestedAt      DateTime                 @default(now())
  reviewedBy       String?
  reviewedAt       DateTime?
  reviewNote       String?
  activationCodeId String?
  affiliate        Affiliate                @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  activationCode   AffiliateActivationCode? @relation(fields: [activationCodeId], references: [id], onDelete: Restrict)

  @@index([status, requestedAt])
  @@index([affiliateId, requestedAt])
  @@map("affiliate_activation_recoveries")
}
