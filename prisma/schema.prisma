generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  name      String
  role      Role       @default(CUSTOMER)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  affiliate Affiliate?
  feedbacks Feedback[]
  orders    Order[]

  @@index([email])
  @@map("users")
}

model Product {
  id                String               @id @default(uuid())
  title             String
  description       String?
  shortDescription  String?
  regularPrice      Float?
  salePrice         Float?
  costPerItem       Float?
  images            Json                 @default("[]")
  variants          Json                 @default("[]")
  sku               String?
  barcode           String?
  stockQuantity     Int?
  stockStatus       String               @default("In Stock")
  brand             String?
  supplier          String?
  tags              String?
  productLabel      String?
  collections       Json                 @default("[]")
  isActive          Boolean              @default(true)
  status            String               @default("Active")
  rating            Float                @default(0)
  ratingsCount      Int                  @default(0)
  reviewsCount      Int                  @default(0)
  feedbackCount     Int                  @default(0)
  limitedTimeDeal   Json?
  landingPageId     String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  allowCOD          Boolean              @default(true)
  allowPrepaid      Boolean              @default(true)
  // Purchase mode (UI label "Purchase Mode"): "checkout" (default — Buy Now →
  // checkout page) or "inline_cod" (Buy Now scrolls to an embedded COD form on
  // the product page). Default preserves existing behaviour; no migration needed.
  purchaseFlow      String               @default("checkout")
  redirectMode      String               @default("default")
  redirectUrl       String?
  sections          Json                 @default("[]")
  // ── Per-product conversion / scarcity ─────────────────────────────────────
  conversionEnabled Boolean              @default(false)
  conversionSold    Int?
  conversionStock   Int?
  // ── Bundle & Save offers (optional, JSON array of bundle objects) ──────────
  bundles           Json                 @default("[]")
  // Product lock (manual, admin-set). true = still listed in the storefront
  // grids (image, name, price + lock icon) but nobody can open its page or buy
  // it — enforced in the product API, the product page and createOrder.
  // Default false = open (current behaviour).
  isLocked          Boolean              @default(false)
  feedbacks         Feedback[]
  orderItems        OrderItem[]
  analytics         ProductAnalytics?
  landingPage       LandingPage?         @relation(fields: [landingPageId], references: [id])
  reviews           Review[]
  scheduledReviews  ScheduledReview[]
  // UGC module (additive back-relation — no DB column). onDelete: Restrict on the
  // child side preserves UGC records if a product is ever removed.
  ugcSubmissions    UgcVideoSubmission[]

  @@index([isActive])
  @@index([status])
  @@index([landingPageId])
  // Products feed (keyset pagination): every feed query is
  //   WHERE status = 'Active' ORDER BY "createdAt" DESC, id DESC
  // so this composite serves the filter AND the sort in one index scan.
  // Ascending is fine — Postgres scans a btree backwards for the DESC order.
  @@index([status, createdAt, id])
  @@map("products")
}

model Collection {
  id                   String   @id @default(uuid())
  title                String   @unique
  slug                 String?  @unique
  description          String?
  image                String?
  banner               String?
  isActive             Boolean  @default(true)
  showOnHomepage       Boolean  @default(false)
  homepageOrder        Int      @default(0)
  homepageProductLimit Int      @default(4)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([title])
  @@index([isActive])
  @@index([showOnHomepage])
  @@map("collections")
}

model Order {
  id              String          @id @default(uuid())
  sessionId       String?         @unique
  status          String          @default("pending")
  customerName    String
  customerEmail   String?
  customerPhone   String?
  shippingAddress Json
  paymentMethod   String?
  paymentStatus   String?         @default("pending")
  paymentTotal    Float?
  paymentDetails  Json?
  campaignSource  CampaignSource?
  utmSource       String?
  affiliateId     String?
  userId          String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  invoice         Invoice?
  items           OrderItem[]
  affiliate       Affiliate?      @relation(fields: [affiliateId], references: [id])
  user            User?           @relation(fields: [userId], references: [id])
  spinEvents      SpinEvent[]

  // ── Bemob conversion tracking ──────────────────────────────────────────
  // bemobClickId          — the Bemob click ID captured at checkout (last_click_id).
  //                         Null when the visitor arrived with no click ID (organic/direct).
  // bemobConversionSentAt — set ONLY after a successful postback. This is the
  //                         idempotency guard: null = never sent, non-null = sent.
  // bemobConversionStatus — "sent" | "failed" | null. Lets the admin see a
  //                         failed attempt distinctly from "never attempted",
  //                         without needing bemobConversionSentAt to be set.
  bemobClickId          String?
  bemobConversionSentAt DateTime?
  bemobConversionStatus String?

  // ── Fake Orders Engine (affiliate motivation) ──────────────────────────────
  // isFake / orderSource are INTERNAL/admin-only. Fake orders reuse the exact
  // same lifecycle + commission pipeline as real ones, but are excluded from
  // every external integration (WhatsApp bot, Bemob, CAPI, shipping, invoices).
  // Default REAL/false so every existing row and code path is unchanged.
  isFake      Boolean @default(false)
  orderSource String  @default("REAL") // "REAL" | "FAKE"

  @@index([status])
  @@index([affiliateId])
  @@index([customerPhone])
  @@index([customerEmail])
  @@index([createdAt])
  @@index([isFake])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  productId       String?
  quantity        Int
  price           Float
  regularPrice    Float?
  productSnapshot Json?
  order           Order    @relation(fields: [orderId], references: [id])
  product         Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId]) // PERF: speeds up "orders containing product X" queries
  @@map("order_items")
}

model Setting {
  id        String   @id
  data      Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ── Duplicate Listings Detector ───────────────────────────────────────────────
// One row per duplicate group the admin chose to ignore.
//
// groupKey    — canonical sorted member-id set. @unique, so an upsert can never
//               create a second Ignore record for the same group.
// fingerprint — the members' updatedAt values. The group stays hidden only while
//               the stored fingerprint still matches; editing ANY member changes
//               it and the group returns for review.
// productIds  — the member ids, kept for display/debugging. Intentionally NOT a
//               relation: product deletes are hard, and a Json array carries no
//               FK, so stale rows are harmless (a group whose members are gone
//               simply never re-forms).
model DuplicateIgnore {
  id          String   @id @default(uuid())
  groupKey    String   @unique
  fingerprint String
  productIds  Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("duplicate_ignores")
}

model AbandonedCart {
  id            String   @id @default(uuid())
  phone         String
  fullName      String?
  email         String?
  city          String?
  items         Json // snapshot of cart items
  cartTotal     Float    @default(0)
  itemCount     Int      @default(0)
  pageAbandoned String? // "address" | "payment" | "confirm"
  recovered     Boolean  @default(false)
  orderId       String? // set when the customer completes checkout → used for success page link
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([phone])
  @@index([recovered])
  @@index([createdAt])
  @@map("abandoned_carts")
}

model Feedback {
  id            String         @id @default(uuid())
  type          FeedbackType
  status        FeedbackStatus @default(PENDING)
  textContent   String?
  mediaUrl      String?
  mediaPublicId String?
  authorName    String?
  rating        Int            @default(5)
  isFeatured    Boolean        @default(false)
  publishAt     DateTime?
  publishedAt   DateTime?
  productId     String?
  userId        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  images        Json           @default("[]")
  isVerified    Boolean        @default(false)
  phone         String?
  productName   String?
  voiceUrl      String?
  /// Admin-editable DISPLAY date for the review ("this feedback happened 2 months
  /// ago"). Nullable and additive: when NULL the UI falls back to createdAt, so
  /// every existing feedback is unaffected. Deliberately NOT createdAt (stripped
  /// by updateFeedback as an audit field), publishAt (drives SCHEDULED
  /// visibility) or publishedAt (overwritten on every approve).
  reviewDate    DateTime?
  product       Product?       @relation(fields: [productId], references: [id])
  user          User?          @relation(fields: [userId], references: [id])

  @@index([status, publishAt])
  @@index([productId])
  @@index([isFeatured])
  @@map("feedbacks")
}

model Affiliate {
  id                   String                  @id @default(uuid())
  username             String                  @unique
  commissionRate       Float                   @default(0.5)
  isActive             Boolean                 @default(false)
  totalClicks          Int                     @default(0)
  totalOrders          Int                     @default(0)
  totalCommission      Float                   @default(0)
  userId               String?                 @unique
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  accountName          String?
  bankName             String?
  name                 String                  @default("")
  phone                String?                 @unique
  avatarUrl            String?
  parentId             String?
  password             String                  @default("")
  rib                  String?
  referralStatus       String                  @default("pending") // "pending" | "active"
  deliveredOrdersCount Int                     @default(0)
  generatedRevenue     Float                   @default(0) // sum of delivered order totals
  teamBonusClaimed     Boolean                 @default(false)
  bonusBalance         Float                   @default(0) // credited on bonus claim
  goalOrders           Int? // Objectif commandes (per-affiliate; null → default 5)
  goalValidReferrals   Int? // Objectif parrainages valides (per-affiliate; null → computed)
  // Session version (Phase 6 part 2): every token carries it; bumped on disable / enable /
  // password change / admin reset, so older tokens are rejected (a token without it = 0).
  tokenVersion         Int                     @default(0)
  clicks               AffiliateClick[]
  notifications        AffiliateNotification[]
  affiliateOrders      AffiliateOrder[]
  payouts              AffiliatePayout[]
  parent               Affiliate?              @relation("AffiliateTeam", fields: [parentId], references: [id])
  children             Affiliate[]             @relation("AffiliateTeam")
  user                 User?                   @relation(fields: [userId], references: [id])
  orders               Order[]
  // UGC module (additive back-relation — no DB column). onDelete: Restrict on the
  // child side preserves UGC submissions/earnings if an affiliate is ever removed.
  ugcSubmissions       UgcVideoSubmission[]
  // Fake Orders Engine (additive back-relation — no DB column).
  fakeOrderConfig      FakeOrderConfig?
  // Identity verification (additive back-relation — no DB column).
  identityVerification IdentityVerification?
  // Security deposits ("Dépôt de garantie") — additive back-relation.
  securityDeposits     AffiliateSecurityDeposit[]
  // Starter Booster purchases — additive back-relation.
  boosterPurchases     AffiliateBoosterPurchase[]
  // Booster DEMO simulation state — additive back-relation.
  boosterSimulations   BoosterSimulation[]
  // Rewards & Gifts (additive back-relations — no DB column). Points are a
  // separate currency: never part of the commission balance providers.
  rewardAccount        RewardPointsAccount?
  rewardLedger         RewardPointsLedger[]
  rewardOrderAwards    RewardOrderAward[]
  rewardRedemptions    RewardRedemption[]
  // "Create Your Own Brand" training simulator (additive back-relation — no DB column).
  brandAccesses        BrandAccess[]
  brandRequestAuthorizations BrandRequestAuthorization[]
  // Affiliate Recruiter System (additive back-relations — no DB column).
  recruiterLink        RecruiterAffiliateLink?
  recruiterRewards     RecruiterRewardLedger[]
  activationCodes      AffiliateActivationCode[]
  activationRecoveries AffiliateActivationRecovery[]

  @@index([username])
  @@index([isActive])
  @@index([parentId])
  @@index([referralStatus])
  @@map("affiliates")
}

// ── Fake Orders Engine — per-affiliate configuration ───────────────────────────
// One row per affiliate the admin has opted into fake-order generation for.
// The engine (scripts/fake-orders-engine.mjs) reads these rows and injects fake
// orders into the EXISTING order/commission pipeline while respecting every
// configured limit. Entirely additive; absence of a row = feature off.
model FakeOrderConfig {
  id               String    @id @default(uuid())
  affiliateId      String    @unique
  enabled          Boolean   @default(false)
  // Rate limits (null = that limit is not enforced). The engine never exceeds
  // the STRICTEST configured limit across minute / hour / day windows.
  ordersPerMinute  Int?
  ordersPerHour    Int?
  ordersPerDay     Int?
  // Random delay between two consecutive orders for this affiliate (seconds).
  minDelaySec      Int       @default(60)
  maxDelaySec      Int       @default(600)
  // Working window (business-timezone local hours, inclusive start .. exclusive end)
  workingHourStart Int       @default(9)
  workingHourEnd   Int       @default(22)
  // CSV of weekday numbers the engine may run on. 0=Sunday … 6=Saturday.
  workingDays      String    @default("0,1,2,3,4,5,6")
  // Product selection: "all" active products, or only the ids in productIds.
  productMode      String    @default("all")
  productIds       Json      @default("[]")
  // Engine bookkeeping — when the last fake order fired and the earliest the next
  // one may fire (lastOrderAt + random(min,max)Delay).
  lastOrderAt      DateTime?
  nextOrderAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  affiliate        Affiliate @relation(fields: [affiliateId], references: [id])

  @@index([enabled])
  @@map("fake_order_configs")
}

// ── Affiliate identity verification (CIN) ──────────────────────────────────────
// One row per affiliate (created on first submission). Absence of a row means
// NOT_SUBMITTED. cinFrontFile / cinBackFile are PRIVATE storage keys (never a
// public URL, never returned in affiliate-facing responses) — the documents are
// streamed only through an admin-authenticated route. Entirely additive.
model IdentityVerification {
  id              String    @id @default(uuid())
  affiliateId     String    @unique
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED (no row = NOT_SUBMITTED)
  cinFrontFile    String? // private storage key
  cinBackFile     String? // private storage key
  rejectionReason String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  approvedBy      String? // admin user id/email who approved (if available)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  affiliate       Affiliate @relation(fields: [affiliateId], references: [id])

  @@index([status])
  @@map("identity_verifications")
}

// ── Affiliate security deposit ("Dépôt de garantie") ──────────────────────────
// Money an affiliate transfers to the company as a security deposit. It is
// COMPLETELY SEPARATE from earnings: the approved-deposit balance is DERIVED from
// the sum of APPROVED rows (ledger-style, like the referral commission balance),
// and it is deliberately NOT registered as a withdrawable balance provider — so
// it can never leak into "Solde disponible" or the withdrawal system. proofFile
// is a PRIVATE storage key (never a public URL). Entirely additive.
model AffiliateSecurityDeposit {
  id                String    @id @default(uuid())
  affiliateId       String
  // Money is stored as DECIMAL(12,2) (NOT Float) — exact 2-dp currency precision.
  // The approved balance is derived and composed with the same Prisma.Decimal
  // strategy the affiliate balance uses (toDecimal / serializeAmount).
  amount            Decimal   @db.Decimal(12, 2)
  paymentMethod     String
  transferReference String?
  proofFile         String // PRIVATE storage key — streamed only via authorized routes
  affiliateNote     String?
  status            String    @default("PENDING") // PENDING | APPROVED | REJECTED
  rejectionReason   String?
  reviewedByAdminId String?
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  affiliate         Affiliate @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId])
  @@index([status])
  // NOTE: a PARTIAL unique index — one PENDING per affiliate — is created in the
  // migration (20260727) via raw SQL (Prisma's DSL can't express `WHERE status`).
  // It makes the "one pending request" rule concurrency-safe at the DB level.
  @@map("affiliate_security_deposits")
}

model AffiliateOrder {
  id               String    @id @default(uuid())
  affiliateId      String
  orderId          String?
  clientName       String?
  clientPhone      String?
  productTitle     String?
  total            Float     @default(0)
  commissionAmount Float     @default(0)
  status           String    @default("pending")
  ipAddress        String?
  isSuspicious     Boolean   @default(false)
  suspicionReason  String?
  // Mirror of Order.isFake so affiliate-side analytics can filter without a join.
  // INTERNAL/admin-only — never surfaced to the affiliate. Default false.
  isFake           Boolean   @default(false)
  createdAt        DateTime  @default(now())
  affiliate        Affiliate @relation(fields: [affiliateId], references: [id])
  // Rewards points award state (additive back-relation — no DB column).
  rewardAward      RewardOrderAward?

  @@index([affiliateId])
  @@index([status])
  @@index([createdAt])
  @@index([ipAddress])
  @@index([isSuspicious])
  @@index([isFake])
  @@map("affiliate_orders")
}

model AffiliatePayout {
  id          String     @id @default(uuid())
  // Owner: EXACTLY ONE of affiliateId / recruiterId (DB CHECK affiliate_payouts_owner_check).
  // Affiliate rows are unchanged; recruiter rows (Affiliate Recruiter System, Phase 5) reuse
  // the same withdrawal workflow but are accounted ONLY against recruiter_reward_ledger.
  affiliateId String?
  amount      Float
  status      String     @default("pending")
  createdAt   DateTime   @default(now())
  affiliate   Affiliate? @relation(fields: [affiliateId], references: [id], onDelete: Restrict) // = the existing FK (unchanged)
  recruiterId String?
  recruiter   Recruiter? @relation(fields: [recruiterId], references: [id], onDelete: Restrict)

  @@index([affiliateId])
  @@index([status])
  @@index([recruiterId])
  @@map("affiliate_payouts")
}

// ── Starter Booster purchases ──────────────────────────────────────────────────
// Paid with the EXISTING derived balance (no separate wallet): a BALANCE-paid
// ACTIVE row is subtracted from "Solde disponible" by the booster_purchase
// balance provider, so the charge IS the row — deduction and activation are one
// atomic write. CARD purchases start PENDING and are activated by an admin.
model AffiliateBoosterPurchase {
  id            String    @id @default(uuid())
  affiliateId   String
  packageId     String
  packageName   String
  price         Float
  paymentMethod String    // "BALANCE" | "CARD"
  status        String    @default("PENDING") // PENDING | ACTIVE | REJECTED
  // Snapshot attribution for BALANCE payments (top-up consumed FIRST, then
  // earnings). Recorded at purchase time so a later top-up can never
  // retroactively convert spent earnings back into withdrawable funds.
  paidFromTopup    Float  @default(0)
  paidFromEarnings Float  @default(0)
  createdAt     DateTime  @default(now())
  activatedAt   DateTime?
  affiliate     Affiliate @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId])
  @@index([status])
  @@map("affiliate_booster_purchases")
}

// ── Starter Booster SIMULATION state (DEMO ONLY) ───────────────────────────────
// One row per ACTIVE booster purchase. `simulatedSales` are DEMO figures shown
// inside the Booster experience ONLY. They are deliberately isolated from the
// real commerce system: no AffiliateOrder row is ever created, no commission,
// no payout, no real statistic and no withdrawable balance is affected. The
// booster PRICE deduction lives on AffiliateBoosterPurchase and is untouched by
// this table — completing a simulation never refunds anything.
model BoosterSimulation {
  id             String    @id @default(uuid())
  purchaseId     String    @unique
  affiliateId    String
  packageId      String
  targetSales    Int       @default(0)
  simulatedSales Int       @default(0)   // DEMO counter — never a real sale
  todaySales     Int       @default(0)   // DEMO counter for the current day
  dayKey         String?                 // business day owning `todaySales`
  startedAt      DateTime  @default(now())
  endsAt         DateTime?
  lastTickAt     DateTime?
  /// RUNNING | PAUSED | COMPLETED — simulation lifecycle ONLY. It never changes
  /// AffiliateBoosterPurchase.status (which drives the balance deduction).
  status         String    @default("RUNNING")
  /// Newest-first demo timeline: [{ at: epochMs, count: n }], capped.
  timeline       Json      @default("[]")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  affiliate      Affiliate @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId])
  @@index([status])
  @@map("booster_simulations")
}

model AffiliateNotification {
  id          String    @id @default(uuid())
  affiliateId String
  message     String
  read        Boolean   @default(false)
  /// Deterministic dedup key for event-driven notifications:
  /// `ugc:{submissionId}:{historyId}:{eventType}:affiliate`.
  /// NULL for notifications from other (non-event-keyed) sources — Postgres allows
  /// many NULLs under a UNIQUE index, so existing rows are unaffected.
  eventKey    String?   @unique
  createdAt   DateTime  @default(now())
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId])
  @@index([read])
  @@map("affiliate_notifications")
}

model AffiliateClick {
  id          String          @id @default(uuid())
  affiliateId String
  ipAddress   String?
  userAgent   String?
  source      CampaignSource?
  landingPage String?
  referer     String?
  createdAt   DateTime        @default(now())
  affiliate   Affiliate       @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId, createdAt])
  @@map("affiliate_clicks")
}

model LandingPage {
  id            String         @id @default(uuid())
  title         String
  slug          String         @unique
  isActive      Boolean        @default(true)
  sections      Json           @default("[]")
  views         Int            @default(0)
  clicks        Int            @default(0)
  sales         Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  description   String?
  heroSubtitle  String?
  heroTitle     String?
  images        Json           @default("[]")
  productId     String?
  templateType  String         @default("classic")
  landingEvents LandingEvent[]
  products      Product[]

  @@index([slug])
  @@index([isActive])
  @@index([productId])
  @@map("landing_pages")
}

model LandingTemplate {
  id           String   @id @default(uuid())
  name         String
  description  String?
  templateType String   @default("custom")
  content      Json     @default("[]")
  previewImage String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("landing_templates")
}

model LandingEvent {
  id            String      @id @default(uuid())
  landingPageId String
  type          String
  affiliateId   String?
  metadata      Json?
  createdAt     DateTime    @default(now())
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@index([landingPageId, type])
  @@index([landingPageId, createdAt])
  @@map("landing_events")
}

model Post {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  category  String
  status    String   @default("Draft")
  data      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([slug])
  @@index([status, category])
  @@map("posts")
}

model Image {
  id        String   @id @default(uuid())
  name      String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("images")
}

model Video {
  id        String   @id @default(uuid())
  name      String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("videos")
}

model ContentItem {
  id         String   @id @default(uuid())
  collection String
  data       Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([collection])
  @@index([collection, createdAt])
  @@map("content_items")
}

model TrackingEvent {
  id             String          @id @default(uuid())
  event          String
  sessionId      String?
  affiliateId    String?
  productId      String?
  landingPageId  String?
  orderId        String?
  campaignSource CampaignSource?
  utmSource      String?
  ipAddress      String?
  userAgent      String?
  referer        String?
  extraData      Json?
  createdAt      DateTime        @default(now())

  @@index([event, createdAt])
  @@index([affiliateId])
  @@index([campaignSource])
  @@index([sessionId])
  @@map("tracking_events")
