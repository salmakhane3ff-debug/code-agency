# ─────────────────────────────────────────────────────────────────────────────
# Media storage backend
#   local → write to public/uploads (default; existing behavior)
#   r2    → upload to Cloudflare R2 (production)
# (Cloudinary is legacy — kept only for reading/deleting partially-migrated URLs;
#  it is NOT used for new uploads.)
MEDIA_STORAGE=local

# ── Cloudflare R2 (required when MEDIA_STORAGE=r2) ────────────────────────────
# Values below are PLACEHOLDERS — set real values only in the untracked .env.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# S3 API endpoint, e.g. https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Public media domain, e.g. https://media.example.com  (drives URLs + CSP/next image host)
R2_PUBLIC_URL=
# Per-site key prefix so multiple sites can share one bucket, e.g. proprogiftvip
R2_PREFIX=

# ── Cloudinary (legacy — only for partially-migrated assets; optional) ───────
# CLOUDINARY_URL=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Demo chat (Phase 3C, simulation only) ─────────────────────────────────────
# Gate 1 of 2. The scripted demo chat is shown only when this is 'true' AND the
# protected settings row "demo-chat-config" has enabled: true. Keep false.
DEMO_CHAT_ENABLED=false
